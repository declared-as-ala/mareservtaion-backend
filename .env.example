# ============================================================
# Ma Reservation — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

NODE_ENV=development
PORT=3001

# ── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mareservation

# ── Authentication (REQUIRED — generate strong secrets) ─────
# Run: openssl rand -base64 64
JWT_SECRET=
REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Email (Resend) — for verification + password reset ──────
RESEND_API_KEY=
EMAIL_FROM=noreply@mareservation.com

# ── Payment — Konnect ──────────────────────────────────────
KONNECT_API_KEY=
KONNECT_SECRET_KEY=
KONNECT_ENTITY_ID=

# ── Uploads / Cloudinary (optional for MVP) ─────────────────
UPLOAD_MAX_FILE_SIZE_MB=50
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
